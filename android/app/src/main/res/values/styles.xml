<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!--
            android:background stays @null: it is the default background for
            views, and leaving it unset avoids drawing under an opaque WebView.
            windowBackground is a different thing, and it was the one missing.
            When the keyboard opens, Android shrinks the WebView and whatever is
            behind it shows through in the gap — with no window background that
            came out black on a light screen. Reported on a OnePlus 7 Pro.
        -->
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/windowBackground</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!--
            Without these Android paints its own dark status bar above the app.
            They cover the launch window only; once the web layer is up,
            @capacitor/status-bar keeps the bar in step with the chosen theme
            (see the theme effect in src/App.tsx). Matching the splash colour
            here means no dark strip flashes before that happens.
        -->
        <item name="android:statusBarColor">@color/splashBackground</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>

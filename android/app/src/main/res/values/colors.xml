<?xml version='1.0' encoding='utf-8'?>
<resources>
    <color name="colorPrimary">#16A34A</color>
    <color name="colorPrimaryDark">#0F7A38</color>
    <color name="colorAccent">#86C95E</color>
    <!-- Must stay equal to #app-splash's background in index.html. -->
    <color name="splashBackground">#F4F6F8</color>
    <!-- What shows in the strip the keyboard leaves when it resizes the
         WebView. Matches the bg token in src/index.css; values-night carries
         the dark one. Keep double hyphens out of XML comments: they are not
         legal, and the resource merger fails the build on them. -->
    <color name="windowBackground">#F4F6F8</color>
</resources>

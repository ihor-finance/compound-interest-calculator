# Copy this file to `keystore.properties` (same folder) and fill in your own
# values. The real file is gitignored and must never be committed or shared.
#
# Create the upload key first. Run this from the `android` folder, in
# PowerShell, on one line. The leading `&` is required: PowerShell reads a
# quoted path as a string rather than a command to run, and without it the
# line fails with `Unexpected token '-genkeypair'`.
#
#   & "C:/Android/jdk-21/bin/keytool" -genkeypair -v -keystore upload-keystore.jks -alias upload -keyalg RSA -keysize 2048 -validity 10000 -dname "CN=Compound Interest Calculator, O=ihor-finance, C=UA"
#
# keytool asks for the password twice and then stops asking. It does not offer
# a separate key password, because the keystore it writes is PKCS12 — the
# format JDK 9 and later default to — where the key password has to equal the
# store password. So there is one password, and both fields below take it.
#
# Type it when asked rather than passing -storepass on the command line:
# anything typed on the line stays in the shell history.

storeFile=upload-keystore.jks
storePassword=CHOOSE_A_PASSWORD
keyAlias=upload
keyPassword=CHOOSE_A_PASSWORD

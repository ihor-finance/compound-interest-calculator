# Copy this file to `keystore.properties` (same folder) and fill in your own
# values. The real file is gitignored and must never be committed or shared.
#
# Create the upload key first — run this from the `android` folder, replacing
# CHOOSE_A_PASSWORD with a password only you know:
#
#   "C:/Android/jdk-21/bin/keytool" -genkeypair -v \
#     -keystore upload-keystore.jks -alias upload \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -storepass CHOOSE_A_PASSWORD -keypass CHOOSE_A_PASSWORD \
#     -dname "CN=Compound Interest Calculator, O=ihor-finance, C=UA"
#
# Then put the same password in both fields below.

storeFile=upload-keystore.jks
storePassword=CHOOSE_A_PASSWORD
keyAlias=upload
keyPassword=CHOOSE_A_PASSWORD

{
  "name": "compound-interest-calculator",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "npm run test:calc && npm run test:i18n && npm run test:listings && npm run test:legal",
    "test:calc": "node --experimental-strip-types --no-warnings scripts/test-calculations.ts",
    "test:i18n": "node --experimental-strip-types --no-warnings scripts/test-locales.ts",
    "android:sync": "npm run build && npx cap sync android",
    "assets:screenshots": "node scripts/capture-screenshots.mjs",
    "assets:icons": "node scripts/generate-android-icons.mjs",
    "test:listings": "node --experimental-strip-types --no-warnings scripts/test-listings.ts",
    "assets:frames": "node --experimental-strip-types --no-warnings scripts/generate-store-frames.mjs",
    "test:legal": "node --experimental-strip-types --no-warnings scripts/test-legal.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/status-bar": "^8.0.3",
    "chart.js": "^4.5.1",
    "country-flag-icons": "^1.6.17",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.16.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
